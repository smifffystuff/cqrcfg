# Mock OIDC Server Configuration

# JWT issuer URL
ISSUER=http://localhost:8888

# JWT claim name used for ACL rules (reads OIDC_ACL_CLAIM first, falls back to MOCK_ACL_CLAIM)
MOCK_ACL_CLAIM=cqrcfg_acl

# Default ACL rules injected when token requests don't specify any (JSON array)
MOCK_DEFAULT_ACL=[{"path":"/config","allow":["read","write","list"]}]
